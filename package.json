{
  "name": "busybar-spotify",
  "private": true,
  "version": "0.1.0",
  "description": "Control Spotify playback and display currently playing music on your BUSY Bar.",
  "author": "blooraayy",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --project jsconfig.json",
    "build": "busy-cli build",
    "app:install": "busy-cli app install",
    "app:uninstall": "busy-cli app uninstall",
    "app:run": "busy-cli app run",
    "app:stop": "busy-cli app stop",
    "postinstall": "node tools/patch-busy-cli.mjs",
    "prebuild": "node tools/patch-busy-cli.mjs",
    "companion": "node companion/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "companion:autostart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File companion/install-autostart.ps1",
    "companion:autostart:remove": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File companion/install-autostart.ps1 -Remove"
  },
  "engines": {
    "node": ">=24 <26"
  },
  "devDependencies": {
    "@busy-app/cli": "0.6.0",
    "typescript": "~6.0.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.21.1"
  }
}
